# Application
APP_NAME=Savdogar
# Production'da HAR DOIM false. true bo'lsa SQL so'rovlari va batafsil
# xatolar logga chiqadi.
DEBUG=false

# MAJBURIY. Bu kalit bilan JWT tokenlar imzolanadi — almashtirilmasa istalgan
# odam superadmin tokeni yasay oladi. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Superadmin. Parol FAQAT hisob birinchi marta yaratilganda ishlatiladi;
# keyin o'zgartirilgan parol server qayta ishga tushganda tiklanmaydi.
SUPERADMIN_EMAIL=admin@turify.xyz
SUPERADMIN_PASSWORD=admin123
# Login formasida "admin" deb yozilsa SUPERADMIN_EMAIL ga o'giriladi.
SUPERADMIN_LOGIN_ALIAS=admin
# Parol unutilsa: yangi parolni SUPERADMIN_PASSWORD ga yozing, buni true
# qilib BIR MARTA deploy qiling, so'ng qaytib false qiling.
SUPERADMIN_FORCE_RESET=false

# Qo'ng'iroq tahlili va AI sayt sozlash (kalit FAQAT serverda turadi —
# frontendga NEXT_PUBLIC_ sifatida hech qachon qo'ymang!)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Database
# Mahalliy ishlab chiqish uchun SQLite yetarli.
DATABASE_URL=sqlite+aiosqlite:///./savdogar.db

# --- Supabase / boshqa Postgres ---
# Supabase -> Project Settings -> Database -> Connection string -> URI
#
# UCH XIL VARIANT bor, farqi muhim:
#
#   Direct        db.<ref>.supabase.co:5432
#                 Faqat IPv6. Railway IPv4 ishlatadi — ULANMAYDI.
#
#   Session pooler   pooler.supabase.com:5432
#                 IPv4, har ulanish o'ziniki. Migratsiya uchun qulay.
#
#   Transaction pooler   pooler.supabase.com:6543   <-- ILOVA UCHUN SHU
#                 IPv4, ulanishlarni tejaydi.
#
# `+asyncpg` yozish shart emas — `config.py` o'zi qo'shadi.
#
# DIQQAT: 6543-portda `database.py` asyncpg prepared statement keshini
# avtomatik o'chiradi. Busiz yuk oshganda tasodifiy
# DuplicatePreparedStatementError chiqadi va sababini topish qiyin.
#
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PAROL@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Parolda maxsus belgi bo'lsa URL-kodlang: @ -> %40, # -> %23, / -> %2F

# Operator kabinet parollarini shifrlash kaliti. Bo'sh bo'lsa SECRET_KEY
# dan hosil qilinadi — lekin SECRET_KEY almashsa parollar o'qilmay qoladi.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# SAYR integratsiya (tashqi tur platforma)
SAYR_API_URL=http://localhost:8001
SAYR_API_KEY=
SAYR_WEBHOOK_SECRET=your-webhook-secret
SAVDOGAR_PUBLIC_URL=https://savdogar-api-production.up.railway.app

# CORS — ruxsat etilgan manbalar ro'yxati. Firma subdomenlari (*.turify.xyz)
# va Vercel preview'lari CORS_ORIGIN_REGEX orqali qo'shimcha ruxsat oladi.
CORS_ORIGINS=http://localhost:3000,https://turify.xyz,https://www.turify.xyz
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*turify\.xyz$|^https://[a-z0-9-]+\.vercel\.app$|^http://localhost:\d+$

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@sayr.uz

# Socket
SOCKET_CORS_ORIGINS=http://localhost:3000,https://savdogar-sable.vercel.app,https://savdogar-five.vercel.app,https://savdogar-agentligi.vercel.app

# Telegram — tarif ozgarishi haqida platforma egasiga xabar
# Token: @BotFather. Chat ID: @userinfobot ga /start yozing.
# Bir nechta qabul qiluvchi bolsa vergul bilan: 123456,7891011
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Instagram / Meta — DM va izohlardan lead yigish
# DIQQAT: App Secret hech qachon kodga yoki chatga tushmasin. Ochilib qolsa —
# Meta konsolida darhol "Reset App Secret" qiling.
#
# Meta'da IKKI xil yol bor, har birining OZ secret'i bor. Qaysi birini
# ishlatsangiz oshanisini toldiring (ikkalasi ham bolsa — ikkalasi tekshiriladi):
#
#  1) "Instagram API with Instagram login" — graph.instagram.com
#     Konsol: Use cases -> Instagram API -> Instagram app ID / secret
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
#  2) "API setup with Facebook login" — graph.facebook.com
#     Konsol: Sozlamalar -> Asosiy -> App ID / App Secret
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Ozingiz oylab topadigan maxfiy matn. Meta konsolidagi webhook "Verify token"
# maydoniga aynan shu qiymat yoziladi.
INSTAGRAM_VERIFY_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
# "Instagram bilan kirish" (OAuth) qaytish manzili. Bosh qoldirilsa
# SAVDOGAR_PUBLIC_URL + /api/instagram/oauth/callback dan yasaladi.
# Meta konsolidagi "Valid OAuth Redirect URIs" bilan AYNAN mos bolishi shart.
INSTAGRAM_REDIRECT_URI=

# Socket.io CORS rejimi: app | list | any
#   app  — CORS'ni ilovaning CORSMiddleware'i hal qiladi (naqsh ishlaydi,
#          firma subdomenlaridan ochilgan admin panel ham ulanadi). Standart.
#   list — faqat SOCKET_CORS_ORIGINS ro'yxati (qat'iy).
#   any  — hammasiga ruxsat (eski xatti-harakat, tavsiya etilmaydi).
SOCKET_CORS_MODE=app

# Telegram webhook manzili endi bot tokenini emas, SECRET_KEY dan hosil
# qilingan taxallusni ishlatadi. SECRET_KEY o'zgarsa botlarni qayta ulang.
